{
  "name": "Hermes",
  "version": "1.4.2",
  "description": "Hermes — all-in-one Discord music bot (Seyfert + Lavalink v4)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@biomejs/biome": "2.6.6",
    "dotenv": "^16.4.7",
    "jimp": "1.6.1",
    "lavalink-client": "2.11.0",
    "picocolors": "^1.1.1",
    "seyfert": "5.2.1",
    "smol-toml": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
